APP_ENV=development
LOG_LEVEL=debug
HTTP_ADDRESS=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=32768
HTTP_REQUEST_TIMEOUT=8s
HTTP_CORS_ORIGINS=http://localhost:3000
HTTP_RATE_PER_SECOND=100
HTTP_RATE_BURST=200
DATABASE_URL=postgres://address_runtime:change_me_runtime_password@localhost:5432/address_intelligence?sslmode=disable
# Use address_runtime for application access after provisioning roles.
# Migration commands require a separate owner/DDL connection:
# MIGRATION_DATABASE_URL=postgres://address_migrator:password@localhost:5432/address_intelligence?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=0
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_PROBE_TIMEOUT=1s
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=5m
DATABASE_STATEMENT_TIMEOUT=5s
# Alternative: clear DATABASE_URL and set these raw values (do not URL-encode).
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=address_intelligence
# DATABASE_USER=address_runtime
# DATABASE_PASSWORD='local$p@ss/#%'
# DATABASE_SSLMODE=disable
ELASTICSEARCH_URL=http://localhost:9200
OUTBOX_POLL_INTERVAL=1s
SHUTDOWN_TIMEOUT=10s
# Optional OTLP/HTTP trace collector endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=
