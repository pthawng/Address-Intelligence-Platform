# Local development only. Never reuse these credentials in production.
APP_ENV=development
# Empty uses the environment-specific default (development=debug, otherwise info).
LOG_LEVEL=
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
# Optional; exporter is not implemented yet.
OTEL_EXPORTER_OTLP_ENDPOINT=
APP_VERSION=dev
BIND_ADDRESS=127.0.0.1
API_PORT=8080
POSTGRES_PORT=5432
ELASTICSEARCH_PORT=9200
POSTGRES_DB=address_intelligence
POSTGRES_USER=address_app
# Local only. Replace before starting the stack; never reuse in production.
POSTGRES_PASSWORD=change_me_to_a_long_random_local_password
OUTBOX_POLL_INTERVAL=1s
SHUTDOWN_TIMEOUT=10s
