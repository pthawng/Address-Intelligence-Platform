{
  "modules": ["administrative", "autocomplete", "datasource", "deliverypoint", "geocoding", "importjob", "outbox", "place", "resolution", "search"],
  "platforms": ["config", "database", "logging", "searchengine", "telemetry"],
  "pure_standard_library": ["bytes", "cmp", "context", "encoding", "errors", "fmt", "math", "maps", "regexp", "slices", "sort", "strconv", "strings", "time", "unicode"],
  "external": [
    {"prefix": "github.com/go-chi/chi/v5", "importers": ["internal/bootstrap/**", "internal/*/transport/http/**"]},
    {"prefix": "github.com/jackc/pgx/v5", "importers": ["internal/platform/database/**", "internal/*/infrastructure/postgres/**"]},
    {"prefix": "github.com/jackc/pgx/v5/pgxpool", "importers": ["internal/platform/database/**"]},
    {"prefix": "github.com/elastic/go-elasticsearch/v9", "importers": ["internal/platform/searchengine/**", "internal/*/infrastructure/elasticsearch/**"]},
    {"prefix": "github.com/go-playground/validator/v10", "importers": ["internal/*/transport/http/**"]},
    {"prefix": "go.opentelemetry.io/otel", "importers": ["internal/platform/telemetry/**", "internal/*/transport/**", "internal/*/infrastructure/**"]},
    {"prefix": "go.opentelemetry.io/otel/sdk", "importers": ["internal/platform/telemetry/**"]},
    {"prefix": "go.opentelemetry.io/otel/exporters", "importers": ["internal/platform/telemetry/**"]},
    {"prefix": "go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp", "importers": ["internal/platform/telemetry/**", "internal/*/transport/http/**"]},
    {"prefix": "github.com/twpayne/go-geom", "importers": ["internal/*/infrastructure/postgres/**"]},
    {"prefix": "github.com/stretchr/testify", "importers": ["internal/**", "test/**"], "test_only": true},
    {"prefix": "github.com/testcontainers/testcontainers-go", "importers": ["test/integration/**", "test/e2e/**"], "test_only": true}
  ]
}
