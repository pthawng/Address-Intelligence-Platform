# Local development only. Never reuse these credentials in production.
APP_ENV=development
# Empty uses the environment-specific default (development=debug, otherwise info).
LOG_LEVEL=
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=32768
HTTP_REQUEST_TIMEOUT=8s
HTTP_CORS_ORIGINS=http://localhost:3000
HTTP_RATE_PER_SECOND=100
HTTP_RATE_BURST=200
# Optional OTLP/HTTP trace collector endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=
APP_VERSION=dev
BIND_ADDRESS=127.0.0.1
API_PORT=8080
POSTGRES_PORT=5432
ELASTICSEARCH_PORT=9200
POSTGRES_DB=address_intelligence
POSTGRES_USER=address_app
# Local only. Replace before starting the stack; never reuse in production.
# Use single quotes for literal special characters, e.g. 'local$p@ss/#%'.
# Backend receives split DATABASE_* fields; Go safely encodes the connection URL.
POSTGRES_PASSWORD=change_me_to_a_long_random_local_password
DATABASE_PASSWORD=change_me_runtime_password
MIGRATION_PASSWORD=change_me_migration_password
# Compose uses raw fields and MIGRATION_PASSWORD; optional URL override:
# MIGRATION_DATABASE_URL=postgres://address_migrator:encoded_password@postgres:5432/address_intelligence?sslmode=disable
OUTBOX_POLL_INTERVAL=1s
SHUTDOWN_TIMEOUT=10s

# Optional: reuse a pre-existing Elasticsearch volume when migrating project names.
# ELASTICSEARCH_DATA_VOLUME=address-intelligence-platform-elasticsearch-data
# ELASTICSEARCH_DATA_EXTERNAL=true
